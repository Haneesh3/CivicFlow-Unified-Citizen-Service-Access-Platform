generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis, pgcrypto]
}

enum Role {
  CITIZEN
  ADMIN
  STAFF
  SUPER_ADMIN
}

enum ComplaintStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  REOPENED
}

model User {
  id        String   @id @default(uuid())
  phone     String?  @unique
  email     String?  @unique
  password  String
  name      String
  role      Role     @default(CITIZEN)
  city      String?
  wardId    String?
  language  String   @default("en")
  resetToken        String?
  resetTokenExpires DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  ward          Ward?          @relation(fields: [wardId], references: [id])
  complaints         Complaint[]
  serviceApplications ServiceApplication[]
  notifications       Notification[]
  auditLogs           AuditLog[]
}


model Ward {
  id   String @id @default(uuid())
  name String
  geom Unsupported("geometry(Polygon, 4326)")?

  users      User[]
  complaints Complaint[]
}

model Complaint {
  id          String          @id @default(uuid())
  title       String
  description String
  category    String
  status      ComplaintStatus @default(SUBMITTED)
  userId      String
  wardId      String?
  geom        Unsupported("geometry(Point, 4326)")?
  address     String?
  imageUrl    String?         // Added for visual evidence
  rating      Int?
  ratingComment String?
  city        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt


  user        User              @relation(fields: [userId], references: [id])
  ward        Ward?             @relation(fields: [wardId], references: [id])
  updates     ComplaintUpdate[]
}

model ComplaintUpdate {
  id          String          @id @default(uuid())
  complaintId String
  status      ComplaintStatus
  comment     String?
  createdAt   DateTime        @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id])
}

model Attachment {
  id         String   @id @default(uuid())
  url        String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())
}

model Department {
  id   String @id @default(uuid())
  name String
}

model Service {
  id              String  @id @default(uuid())
  title           String  @unique
  description     String
  category        String
  ministry        String
  tags            String?
  integrationType String
  applyUrl        String?
  
  subServices     SubService[]
  serviceCenters  ServiceCenter[]
}

model SubService {
  id                String   @id @default(uuid())
  serviceId         String
  name              String
  description       String?
  requiredDocuments String[] // Array of document names
  
  service Service @relation(fields: [serviceId], references: [id])
}

model ServiceCenter {
  id        String @id @default(uuid())
  serviceId String
  name      String
  address   String
  lat       Float?
  lng       Float?
  
  service Service @relation(fields: [serviceId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

model Holiday {
  id    String   @id @default(uuid())
  date  DateTime @unique
  name  String
}

model ServiceApplication {
  id              String            @id @default(uuid())
  serviceId       String
  userId          String
  subServiceId    String?
  serviceCenterId String?
  applicantName   String
  applicantPhone  String
  data            Json
  status          ApplicationStatus @default(SUBMITTED)
  referenceId     String            @unique
  appointmentDate DateTime?
  appointmentSlot String?
  city            String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id])
  updates ServiceApplicationUpdate[]
}

model ServiceApplicationUpdate {
  id              String            @id @default(uuid())
  applicationId   String
  status          ApplicationStatus
  message         String
  createdAt       DateTime          @default(now())

  application     ServiceApplication @relation(fields: [applicationId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

